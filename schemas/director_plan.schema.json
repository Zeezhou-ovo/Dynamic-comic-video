{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dynamic-comic-video:director_plan:0.1",
  "title": "director_plan",
  "type": "object",
  "properties": {
    "version": {"const": "0.1"},
    "project_id": {"type": "string", "minLength": 1},
    "timing_source": {"const": "director_plan"},
    "shots": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "instance_id": {"type": "string", "minLength": 1},
          "source_shot_id": {"type": "string", "minLength": 1},
          "shot_intent": {"enum": ["establishing_wide", "group_shot", "two_shot", "speaker_medium", "speaker_closeup", "listener_reaction", "insert", "emphasis_push"]},
          "camera_intent": {"enum": ["static", "subtle_push", "stronger_push", "follow"]},
          "focus_character": {"type": ["string", "null"]},
          "emphasis": {"enum": ["normal", "important", "reveal", "punchline", "awkward", "surprise"]},
          "beats": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "beat_id": {"type": "string", "minLength": 1},
                "kind": {"enum": ["dialogue", "reaction", "pause"]},
                "speaker": {"type": "string", "minLength": 1},
                "text": {"type": "string", "minLength": 1},
                "intent": {"enum": ["neutral", "ask", "explain", "confirm", "joke", "react"]},
                "emotion": {"type": "string", "minLength": 1},
                "emphasis": {"enum": ["normal", "important", "reveal", "punchline", "awkward", "surprise"]},
                "listeners": {"type": "array", "items": {"type": "string", "minLength": 1}},
                "reaction_target": {"type": ["string", "null"]},
                "reaction": {"enum": ["neutral", "interested", "confused", "surprised", "speechless", "awkward", "annoyed", "amused", "laugh"]},
                "reaction_strength": {"enum": ["subtle", "medium", "strong"]},
                "performance_intent": {"type": "string", "minLength": 1},
                "duration_frames": {"type": "integer", "minimum": 1},
                "pause_before": {"type": "integer", "minimum": 0},
                "pause_after": {"type": "integer", "minimum": 0},
                "reaction_hold": {"type": "integer", "minimum": 0},
                "shot_intent": {"enum": ["establishing_wide", "group_shot", "two_shot", "speaker_medium", "speaker_closeup", "listener_reaction", "insert", "emphasis_push"]}
              },
              "required": ["beat_id", "kind", "pause_before", "pause_after"],
              "allOf": [
                {"if": {"properties": {"kind": {"const": "dialogue"}}, "required": ["kind"]}, "then": {"required": ["speaker", "text", "intent", "emotion", "emphasis", "listeners", "performance_intent", "duration_frames"]}},
                {"if": {"properties": {"kind": {"const": "reaction"}}, "required": ["kind"]}, "then": {"required": ["reaction_target", "reaction", "reaction_hold"]}},
                {"if": {"properties": {"kind": {"const": "pause"}}, "required": ["kind"]}, "then": {"required": ["duration_frames"]}}
              ],
              "additionalProperties": false
            }
          }
        },
        "required": ["instance_id", "source_shot_id", "shot_intent", "camera_intent", "emphasis", "beats"],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "project_id", "timing_source", "shots"],
  "additionalProperties": false
}
