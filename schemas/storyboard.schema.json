{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dynamic-comic-video:storyboard:0.1",
  "title": "storyboard",
  "type": "object",
  "properties": {
    "version": {
      "const": "0.1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "beats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_panel": {"type":"string","minLength":1},
          "source_excerpt": {
            "type": "string",
            "minLength": 1
          },
          "change": {
            "type": "string",
            "minLength": 1
          },
          "emotion": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "source_excerpt",
          "change",
          "emotion"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "scenes": {
      "type":"array","minItems":1,
      "items":{"type":"object","properties":{
        "id":{"type":"string","minLength":1},
        "space":{"type":"string","minLength":1},
        "time":{"type":"string","minLength":1},
        "lighting":{"type":"string","minLength":1},
        "anchors":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
      },"required":["id","space","time","lighting","anchors"],"additionalProperties":false}
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_panel": {
            "type": "string",
            "minLength": 1
          },
          "beat_id": {
            "type": "string",
            "minLength": 1
          },
          "duration_frames": {
            "type": "integer",
            "minimum": 2
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "transition": {"const": "cut"},
          "direction": {
            "type":"object","properties":{
              "scene_id":{"type":"string","minLength":1},
              "camera_position":{"type":"string","minLength":1},
              "background_view":{"type":"string","minLength":1},
              "view_id":{"type":"string","minLength":1},
              "incoming_state":{"type":"string","minLength":1},
              "outgoing_state":{"type":"string","minLength":1},
              "micro_actions":{"type":"string","minLength":1},
              "cut_reason":{"type":"string","minLength":1},
              "next_shot_id":{"type":["string","null"],"minLength":1},
              "handoff":{"type":"string","minLength":1},
              "reaction_hold_frames":{"type":"integer","minimum":0},
              "listening_reactions":{"type":"array","items":{"type":"object","properties":{
                "character_id":{"type":"string","minLength":1},
                "response":{"type":"string","minLength":1}
              },"required":["character_id","response"],"additionalProperties":false}}
            },
            "required":["scene_id","camera_position","background_view","view_id","incoming_state","outgoing_state","micro_actions","cut_reason","next_shot_id","handoff","reaction_hold_frames","listening_reactions"],"additionalProperties":false
          },
          "dialogue": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "speaker": {"type": "string", "minLength": 1},
                "text": {"type": "string", "minLength": 1},
                "audio": {"type":"string","pattern":"^(?!/)(?!.*\\.\\.)(?!.*:)(?!.*\\\\).+\\.wav$"},
                "timing_source": {"enum":["estimated","audio"]},
                "start_frame": {"type": "integer", "minimum": 0},
                "end_frame": {"type": "integer", "minimum": 1}
              },
              "required": ["speaker", "text", "start_frame", "end_frame"],
              "additionalProperties": false
            }
          },
          "sound_effects": {"type":"array","items":{"type":"string","minLength":1}},
          "setting": {
            "type": "string",
            "minLength": 1
          },
          "shot_size": {
            "enum": [
              "extreme_wide",
              "wide",
              "medium",
              "close_up",
              "extreme_close_up"
            ]
          },
          "angle": {
            "enum": [
              "eye_level",
              "high",
              "low",
              "overhead"
            ]
          },
          "composition": {
            "type": "string",
            "minLength": 1
          },
          "composition_tag": {
            "enum": [
              "center",
              "left_third",
              "right_third",
              "diagonal",
              "symmetrical"
            ]
          },
          "characters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "character_id": {
                  "type": "string",
                  "minLength": 1
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "pose_tag": {
                  "type": "string",
                  "minLength": 1
                },
                "expression": {
                  "type": "string",
                  "minLength": 1
                },
                "gaze": {
                  "type": "string",
                  "minLength": 1
                },
                "posture": {"enum": ["standing", "seated", "lying", "kneeling", "crouching", "riding", "other"]},
                "placement": {"type": "string", "minLength": 1},
                "posture_change": {"type": "string", "minLength": 1}
              },
              "required": [
                "character_id",
                "action",
                "pose_tag",
                "expression",
                "gaze"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "continuity": {
            "type": "string",
            "minLength": 1
          },
          "master": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)(?!.*:)(?!.*\\\\).+"
          },
          "layers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "enum": [
                    "background",
                    "panel_base",
                    "character",
                    "foreground",
                    "effects"
                  ]
                },
                "character_id": {
                  "type": "string",
                  "minLength": 1
                },
                "elements": {
                  "type": "string",
                  "minLength": 1
                },
                "method": {
                  "enum": [
                    "reconstruct",
                    "extract",
                    "extract_or_reconstruct"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "role",
                "elements",
                "method",
                "reason"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "reveal": {
            "type": "object",
            "properties": {
              "what": {"type": "string", "minLength": 1},
              "hold_frames": {"type": "integer", "minimum": 0}
            },
            "required": ["what"],
            "additionalProperties": false
          },
          "repetition_exception": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "beat_id",
          "duration_frames",
          "purpose",
          "setting",
          "shot_size",
          "angle",
          "composition",
          "composition_tag",
          "characters",
          "continuity",
          "master",
          "layers",
          "repetition_exception"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "version",
    "project_id",
    "beats",
    "shots"
  ],
  "additionalProperties": false
}
