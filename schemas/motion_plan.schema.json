{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dynamic-comic-video:motion_plan:0.4",
  "title": "motion_plan",
  "type": "object",
  "properties": {
    "version": {
      "enum": ["0.1", "0.2", "0.3", "0.4"]
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "asset_mode": {
      "enum": [
        "fixture",
        "preview",
        "production"
      ]
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "shot_id": {
            "type": "string",
            "minLength": 1
          },
          "performance": {
            "type": "object",
            "properties": {
              "mode": {"enum": ["limited-animation", "fixed-camera-micro", "sequential-comic"]},
              "intent": {"type": "string", "minLength": 1},
              "static_reason": {"type": "string", "minLength": 1},
              "reviewed": {"type": "boolean"}
            },
            "required": ["intent", "reviewed"],
            "additionalProperties": false
          },
          "start_frame": {
            "type": "integer",
            "minimum": 0
          },
          "duration_frames": {
            "type": "integer",
            "minimum": 2
          },
          "transition": {
            "const": "cut"
          },
          "camera": {
            "$ref": "#/$defs/camera"
          },
          "timeline": {
            "$ref": "#/$defs/timeline"
          },
          "layers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "layer_id": {
                  "type": "string",
                  "minLength": 1
                },
                "depth": {
                  "enum": ["foreground", "character", "midground", "background", "sky"]
                },
                "acting": {"$ref": "#/$defs/acting"},
                "region": {"type":"array","items":{"type":"number","minimum":0,"maximum":1},"minItems":4,"maxItems":4},
                "asset": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*\\.\\.)(?!.*:)(?!.*\\\\).+"
                },
                "z": {
                  "type": "integer"
                },
                "from": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "scale": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 1.3
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "scale"
                  ],
                  "additionalProperties": false
                },
                "to": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "scale": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 1.3
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "scale"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "layer_id",
                "asset",
                "z",
                "from",
                "to"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "review": {
            "type": "object",
            "properties": {
              "master_alignment": {
                "type": "boolean"
              },
              "background_completed": {
                "type": "boolean"
              },
              "motion_bounds_checked": {
                "type": "boolean"
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "master_alignment",
              "background_completed",
              "motion_bounds_checked",
              "notes"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "shot_id",
          "start_frame",
          "duration_frames",
          "transition",
          "layers",
          "review"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "version",
    "project_id",
    "asset_mode",
    "shots"
  ],
  "additionalProperties": false,
  "$defs": {
    "camera": {
      "type": "object",
      "properties": {
        "type": {"enum": ["static", "push_in", "pull_out", "pan_left", "pan_right", "follow"]},
        "focus_target": {
          "type": "object",
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "x": {"type": "number"},
            "y": {"type": "number"}
          },
          "required": ["x", "y"],
          "additionalProperties": false
        },
        "from": {"$ref": "#/$defs/camera_pose"},
        "to": {"$ref": "#/$defs/camera_pose"},
        "follow_path": {
          "type": "array",
          "items": {"$ref": "#/$defs/camera_path_point"},
          "minItems": 2
        },
        "easing": {"enum": ["linear", "easeIn", "easeOut", "easeInOut"]},
        "screen_target": {
          "type": "object",
          "properties": {
            "x": {"type": "number", "minimum": 0, "maximum": 1},
            "y": {"type": "number", "minimum": 0, "maximum": 1}
          },
          "required": ["x", "y"],
          "additionalProperties": false
        },
        "parallax_enabled": {"type": "boolean"},
        "parallax_strengths": {
          "type": "object",
          "properties": {
            "foreground": {"type": "number", "minimum": 0, "maximum": 2},
            "character": {"type": "number", "minimum": 0, "maximum": 2},
            "midground": {"type": "number", "minimum": 0, "maximum": 2},
            "background": {"type": "number", "minimum": 0, "maximum": 2},
            "sky": {"type": "number", "minimum": 0, "maximum": 2}
          },
          "additionalProperties": false
        }
      },
      "required": ["type", "parallax_enabled"],
      "additionalProperties": false
    },
    "camera_pose": {
      "type": "object",
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "zoom": {"type": "number", "exclusiveMinimum": 0}
      },
      "required": ["x", "y", "zoom"],
      "additionalProperties": false
    },
    "camera_path_point": {
      "type": "object",
      "properties": {
        "frame": {"type": "integer", "minimum": 0},
        "x": {"type": "number"},
        "y": {"type": "number"}
      },
      "required": ["frame", "x", "y"],
      "additionalProperties": false
    },
    "acting": {
      "type": "object",
      "properties": {
        "part": {"enum": ["whole", "head", "arm", "hand", "eyes", "mouth", "prop", "interface"]},
        "speech": {
          "type":"object",
          "properties":{
            "speaker":{"type":"string","minLength":1},
            "closed_asset":{"type":"string","pattern":"^(?!/)(?!.*\\.\\.)(?!.*:)(?!.*\\\\).+"},
            "open_asset":{"type":"string","pattern":"^(?!/)(?!.*\\.\\.)(?!.*:)(?!.*\\\\).+"}
          },
          "required":["speaker","closed_asset","open_asset"],"additionalProperties":false
        },
        "events": {
          "type":"array",
          "items":{"type":"object","properties":{
            "event_id":{"type":"string","minLength":1},
            "trigger":{"enum":["speech","information","pause","emotion","action"]},
            "start_frame":{"type":"integer","minimum":0},
            "peak_frame":{"type":"integer","minimum":0},
            "settle_frame":{"type":"integer","minimum":0},
            "end_frame":{"type":"integer","minimum":0},
            "description":{"type":"string","minLength":1}
          },"required":["event_id","trigger","start_frame","peak_frame","settle_frame","end_frame","description"],"additionalProperties":false}
        },
        "pivot": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 2, "maxItems": 2},
        "keys": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object",
            "properties": {
              "frame": {"type": "integer", "minimum": 0},
              "x": {"type": "number"}, "y": {"type": "number"},
              "rotation": {"type": "number", "minimum": -180, "maximum": 180},
              "opacity": {"type": "number", "minimum": 0, "maximum": 1}
            },
            "required": ["frame", "x", "y", "rotation", "opacity"], "additionalProperties": false
          }
        },
        "poses": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object",
            "properties": {
              "frame": {"type": "integer", "minimum": 0},
              "asset": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)(?!.*:)(?!.*\\\\).+"}
            }, "required": ["frame", "asset"], "additionalProperties": false
          }
        }
      },
      "required": ["part", "pivot", "keys"], "additionalProperties": false
    },
    "timeline": {
      "type": "object",
      "properties": {
        "scene_id": {"type": "string", "minLength": 1},
        "duration_frames": {"type": "integer", "minimum": 2},
        "audio": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)(?!.*:)(?!.*\\\\).+"},
        "audio_start_frame": {"type": "integer", "minimum": 0},
        "subtitle_events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start_frame": {"type": "integer", "minimum": 0},
              "end_frame": {"type": "integer", "minimum": 1},
              "text": {"type": "string", "minLength": 1},
              "emphasis": {"type": "string"}
            },
            "required": ["start_frame", "end_frame", "text"],
            "additionalProperties": false
          }
        },
        "speech_intervals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start_frame": {"type": "integer", "minimum": 0},
              "end_frame": {"type": "integer", "minimum": 1},
              "speaker": {"type": "string", "minLength": 1}
            },
            "required": ["start_frame", "end_frame", "speaker"],
            "additionalProperties": false
          }
        },
        "action_events": {
          "type": "array",
          "items": {
            "allOf": [
              {"$ref": "#/$defs/event"},
              {"type": "object", "properties": {"keyword": {"type": "string"}}}
            ]
          }
        },
        "expression_events": {"$ref": "#/$defs/event_list"},
        "blink_events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "frame": {"type": "integer", "minimum": 0},
              "description": {"type": "string", "minLength": 1}
            },
            "required": ["frame", "description"],
            "additionalProperties": false
          }
        },
        "sound_events": {"$ref": "#/$defs/event_list"},
        "visual_events": {"$ref": "#/$defs/visual_event_list"},
        "music_duck_events": {"$ref": "#/$defs/music_duck_list"},
        "cut_at_frame": {"type": "integer", "minimum": 0}
      },
      "required": ["scene_id", "duration_frames", "subtitle_events", "speech_intervals", "action_events", "expression_events", "blink_events", "sound_events", "cut_at_frame"],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "trigger": {"enum": ["speech", "information", "pause", "emotion", "action"]},
        "start_frame": {"type": "integer", "minimum": 0},
        "peak_frame": {"type": "integer", "minimum": 0},
        "settle_frame": {"type": "integer", "minimum": 0},
        "end_frame": {"type": "integer", "minimum": 0},
        "description": {"type": "string", "minLength": 1}
      },
      "required": ["event_id", "trigger", "start_frame", "peak_frame", "settle_frame", "end_frame", "description"],
      "additionalProperties": false
    },
    "event_list": {
      "type": "array",
      "items": {"$ref": "#/$defs/event"}
    },
    "visual_event_list": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "priority": {"enum": ["ordinary", "emphasis", "emotion", "punchline"]},
          "effect_type": {"enum": ["sweat_drop", "black_line", "vein", "shock_lines", "speed_lines", "question", "exclamation", "ellipsis", "sparkle", "flash", "background_simplify", "background_tint", "focus_lines", "screen_shake", "subtitle_emphasis"]},
          "start_frame": {"type": "integer", "minimum": 0},
          "end_frame": {"type": "integer", "minimum": 1},
          "description": {"type": "string", "minLength": 1}
        },
        "required": ["event_id", "priority", "effect_type", "start_frame", "end_frame", "description"],
        "additionalProperties": false
      }
    },
    "music_duck_list": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start_frame": {"type": "integer", "minimum": 0},
          "end_frame": {"type": "integer", "minimum": 1},
          "target_volume": {"type": "number", "minimum": 0, "maximum": 1},
          "reason": {"type": "string", "minLength": 1}
        },
        "required": ["start_frame", "end_frame", "target_volume", "reason"],
        "additionalProperties": false
      }
    }
  }
}
