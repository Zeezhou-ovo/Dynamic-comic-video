{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": "0.1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "required_props": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]+$"
      },
      "uniqueItems": true
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "beat_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "speaker": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "intent": {
            "enum": [
              "neutral",
              "ask",
              "explain",
              "confirm",
              "joke",
              "react"
            ]
          },
          "emphasis": {
            "enum": [
              "normal",
              "important",
              "reveal",
              "punchline",
              "awkward",
              "surprise"
            ]
          },
          "reaction": {
            "enum": [
              "neutral",
              "interested",
              "confused",
              "surprised",
              "speechless",
              "awkward",
              "annoyed",
              "amused",
              "laugh"
            ]
          },
          "reaction_target": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          }
        },
        "required": [
          "beat_id",
          "speaker",
          "text",
          "intent",
          "emphasis"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "project_id",
    "beats"
  ],
  "additionalProperties": false
}
