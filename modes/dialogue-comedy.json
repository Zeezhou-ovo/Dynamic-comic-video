{
  "version": "0.1",
  "mode_id": "dialogue-comedy",
  "description": "dialogue-comedy executable directing policy",
  "policy": {
    "shot": {
      "max_dialogue_beats": 2,
      "normal_intents": [
        "two_shot",
        "speaker_medium"
      ],
      "emphasis_intent": "speaker_closeup"
    },
    "reaction": {
      "every_n_beats": 2,
      "strength": "medium",
      "hold_frames": 22,
      "closeup": true
    },
    "camera": {
      "intent": "subtle_push",
      "emphasis_intent": "stronger_push",
      "strength": 1,
      "motion_every_n_shots": 2
    },
    "timing": {
      "line_pause_frames": 3,
      "emphasis_pause_before": 18,
      "emphasis_pause_after": 30,
      "reading_frames_per_character": 3.5,
      "minimum_line_frames": 42
    },
    "performance": {
      "explain_gesture": true,
      "event_strength": 1
    },
    "parallax": {
      "enabled": true,
      "strength": 0.7
    },
    "subtitle": {
      "font_height_ratio": 0.047,
      "emphasis_scale": 1.15,
      "hold_frames": 3
    }
  },
  "requirements": {
    "min_characters": 1,
    "min_depth_layers": 2,
    "required_parts": [
      "body",
      "head",
      "eyes",
      "mouth"
    ]
  }
}
